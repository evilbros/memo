{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "session.first": "ctrl+pageup",
    "session.last": "ctrl+pagedown",
    "input.line.home": "home",
    "input.line.end": "end",
    "input.buffer.home": "ctrl+home",
    "input.buffer.end": "ctrl+end"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
